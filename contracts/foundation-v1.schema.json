        },
        "account_id": {
          "$ref": "#/definitions/ID"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "FOUNDATION",
                "FIXTURE"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        "event_type": {
          "const": "HEALTH"
        },
        "payload": {
          "$ref": "#/definitions/Health"
